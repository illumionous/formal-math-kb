{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illumionous/formal-math-kb/schema/knowledge_point.schema.json",
  "title": "Atomic formal mathematics knowledge point",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "level", "parents", "prerequisites", "related", "statement_latex", "statement_lean", "tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$"},
    "title": {"type": "string", "minLength": 3},
    "level": {"type": "integer", "minimum": 0},
    "parents": {"type": "array", "items": {"type": "string"}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "related": {"type": "array", "items": {"type": "string"}},
    "statement_latex": {"type": "string", "minLength": 8},
    "statement_lean": {"type": "string", "minLength": 10},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
